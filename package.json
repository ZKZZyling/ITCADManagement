{
  "name": "itcad-management",
  "version": "0.4.0",
  "private": true,
  "description": "Traceable CAD review and offline field inspection workspace",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "demo": "node scripts/create-demo.mjs",
    "start": "node server/local.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "locales": "node scripts/build-locales.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "@mlightcad/cad-simple-viewer": "1.7.5",
    "@mlightcad/cad-simple-ui-plugin": "1.7.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
